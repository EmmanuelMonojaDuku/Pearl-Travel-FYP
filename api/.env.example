# ==============================================================================
# Pearl Travel — Independent Node.js API (Phase 1)
# Copy this file to `.env` for local development.
# NEVER commit `.env` or real credentials to version control.
# ==============================================================================

# Server Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Allowed Frontend Origins (comma-separated)
# Example: http://localhost:3000,https://pearltravel.ug
CORS_ORIGINS=http://localhost:3000

# Public Base URL used for constructing email verification / password reset links
APP_BASE_URL=http://localhost:3000

# Comma-separated bootstrap administrator accounts. Each account must verify
# its email before the API grants the admin_staff role on a successful login.
ADMIN_EMAILS=emmanuelmonojaduku@gmail.com

# ==============================================================================
# Supabase PostgreSQL Connection (Server-Side Only)
# Prefer a restricted PostgreSQL application role over unrestricted postgres/admin.
# Use Supabase Session Pooler (port 5432) or Transaction Pooler (port 6543) URL.
# ==============================================================================
DATABASE_URL=postgresql://pearl_api_app:CHANGE_ME_STRONG_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_SSL_MODE=require
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Optional separate migration connection string (only used by `npm run migrate`
# when schema ownership privileges are separated from runtime CRUD role)
MIGRATION_DATABASE_URL=

# ==============================================================================
# Independent Node.js Authentication Secrets (NEVER expose to web/mobile clients)
# Generate high-entropy secrets: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
# ==============================================================================
JWT_ACCESS_SECRET=CHANGE_ME_REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_REFRESH_SECRET
JWT_ISSUER=pearl-travel-api
JWT_AUDIENCE=pearl-travel-clients

# Token Lifetimes (seconds)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800

# Argon2id Tuning (OWASP baseline)
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# ==============================================================================
# Transactional Email Service (Verification & Password Recovery)
# Keep `disabled` until a real provider (e.g., resend) is configured & tested.
# ==============================================================================
EMAIL_PROVIDER=disabled
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=
REQUIRE_EMAIL_VERIFICATION=false

# ------------------------------------------------------------------------------
# QR pass signing (required in production). Generate with: node scripts/generate-qr-key.mjs
# Without it, development uses an ephemeral key: passes stop verifying when the server restarts.
# ------------------------------------------------------------------------------
QR_SIGNING_PRIVATE_KEY=
QR_SIGNING_KEY_ID=k1

# ------------------------------------------------------------------------------
# Assistant (RAG). Any OpenAI-compatible provider. Without LLM_API_KEY the assistant answers
# "not configured" (HTTP 503) instead of pretending. Keys live ONLY here, never in the web app.
# ------------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
RAG_MIN_SIMILARITY=0.3
RAG_TOP_K=4
