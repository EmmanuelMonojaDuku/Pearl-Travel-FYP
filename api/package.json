{
  "name": "pearl-travel-api",
  "version": "0.1.0",
  "description": "Independent Node.js + TypeScript + Fastify backend for Pearl Travel (Malaba OSBP Pre-Arrival Guidance & Passenger Readiness)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "migrate": "tsx src/database/migrate.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "migrate:validate": "tsx src/database/migrate.ts --validate"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "argon2": "^0.41.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.3.3",
    "jose": "^6.0.11",
    "pg": "^8.16.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.17",
    "@types/pg": "^8.11.14",
    "eslint": "^9.26.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
