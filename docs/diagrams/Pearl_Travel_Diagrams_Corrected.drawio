        <mxCell id="rules" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;rounded=0;spacing=8;" value="&lt;b&gt;Design rules&lt;/b&gt;&lt;br&gt;&amp;bull; Self-declared checklist: no document numbers or uploads (declared_status).&lt;br&gt;&amp;bull; Requirement Rule is deterministic; null FK = applies to any.&lt;br&gt;&amp;bull; Mandatory level lives only in Requirement Rule; the rule and version used are stored on the checklist item, so scores are reproducible.&lt;br&gt;&amp;bull; QR Summary holds a signed token + expiry, no personal data.&lt;br&gt;&amp;bull; Inbound travellers to Uganda only (no direction field)." vertex="1">
          <mxGeometry height="220" width="300" x="760" y="40" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;rounded=0;spacing=8;" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6C8EBF&quot;&gt;&amp;#9632;&lt;/span&gt; Traveller data &amp;nbsp; &lt;span style=&quot;color:#D79B00&quot;&gt;&amp;#9632;&lt;/span&gt; Assessment &amp;amp; QR&lt;br&gt;&lt;span style=&quot;color:#D6B656&quot;&gt;&amp;#9632;&lt;/span&gt; Rules &amp;amp; lookups &amp;nbsp; &lt;span style=&quot;color:#82B366&quot;&gt;&amp;#9632;&lt;/span&gt; Knowledge &amp;amp; AI&lt;br&gt;&lt;span style=&quot;color:#9673A6&quot;&gt;&amp;#9632;&lt;/span&gt; Staff &amp;amp; audit &amp;nbsp; &lt;span style=&quot;color:#2E9AA4&quot;&gt;&amp;#9632;&lt;/span&gt; Content" vertex="1">
          <mxGeometry height="70" width="300" x="760" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="design-note-ERD1" parent="acc" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;whiteSpace=wrap;overflow=hidden;fontSize=10;" value="&lt;b&gt;Conceptual design ERD.&lt;/b&gt; The built schema is on page 7 &quot;ERD as built&quot;. Main differences: rules are JSON metadata rather than lookup tables, roles are a join table, officers can have several border posts, QR stores a token digest, content has a review workflow, notifications and media tables are not built." vertex="1">
          <mxGeometry height="60" width="240" y="184.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
