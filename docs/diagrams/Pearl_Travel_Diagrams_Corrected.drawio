        <mxCell id="n2" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;rounded=0;spacing=8;" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;A null FK in Requirement Rule means the rule applies to any value. Mandatory / recommended / conditional is held only in &lt;i&gt;requirement_level&lt;/i&gt;. Higher &lt;i&gt;priority&lt;/i&gt; wins when rules overlap." vertex="1">
          <mxGeometry height="110" width="300" x="400" y="420" as="geometry" />
        </mxCell>
        <mxCell id="design-note-ERD2" parent="grp" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;whiteSpace=wrap;overflow=hidden;fontSize=10;" value="&lt;b&gt;Conceptual design ERD.&lt;/b&gt; The built schema is on page 7 &quot;ERD as built&quot;. Main differences: rules are JSON metadata rather than lookup tables, roles are a join table, officers can have several border posts, QR stores a token digest, content has a review workflow, notifications and media tables are not built." vertex="1">
          <mxGeometry height="60" width="240" y="86.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
